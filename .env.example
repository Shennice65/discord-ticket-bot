# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678

# Role and Channel IDs
OBSERVER_ROLE_ID=123456789012345678
LOG_CHANNEL_ID=123456789012345678
TICKET_CATEGORY_ID=123456789012345678

# Tier Role IDs 
PHANTOM_ROLE_ID=123456789012345678
CHAMPION_ROLE_ID=123456789012345678
ELITE_ROLE_ID=123456789012345678
LEGEND_ROLE_ID=123456789012345678
MASTER_ROLE_ID=123456789012345678
NOVICE_ROLE_ID=123456789012345678

# Database Configuration
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
# Use a separate name such as discord_bot_test for isolated local testing.
# Production keeps the existing discord_bot_db default when this is omitted.
MONGO_DB_NAME=discord_bot_db
# Local HTTP testing only. Keep true in production.
WEB_SESSION_COOKIE_SECURE=true

# Hive visual moderation. Clips fail closed and remain private when this is absent.
HIVE_API_KEY=your_hive_visual_moderation_api_key
# Optional moderation tuning.
HIVE_NSFW_THRESHOLD=0.90
HIVE_BLOCKED_CLASSES=general_nsfw,general_suggestive
HIVE_TIMEOUT_SECONDS=120

# Clips Service (Render)
CLIPS_SERVICE_URL=https://your-clips-app.onrender.com

# Public tournament website used by the private /website-login command.
# Falls back to CLIPS_SERVICE_URL when omitted.
BETTING_SITE_URL=https://your-tournament-site.example

# Basic alternate-account protection for website login.
WEB_LOGIN_MIN_ACCOUNT_AGE_DAYS=30
WEB_LOGIN_MIN_MEMBERSHIP_DAYS=7

# Optional website match-control admins (comma-separated Discord user IDs).
# The same setting can be stored as BETTING_ADMIN_DISCORD_IDS in MongoDB.
MASTER_ADMIN_ID=123456789012345678

# Default group-stage calendar (Saturday/Sunday at 8 PM Vietnam time).
BETTING_TIMEZONE=Asia/Ho_Chi_Minh
BETTING_MATCH_HOUR=20
BETTING_LOCK_MINUTES=5

# Optional Discord tournament announcements. The recommended setup is the
# /betting-notifications command, which stores these values in MongoDB.
BETTING_NOTIFICATION_CHANNEL_ID=123456789012345678
BETTING_NOTIFICATION_ROLE_ID=123456789012345678
